{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "training-coco-v1.schema.json",
  "title": "Project6 self-contained COCO training package V1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_type",
    "package_id",
    "created_at",
    "producer",
    "annotation_format",
    "task",
    "label_origin",
    "annotation_path",
    "image_root",
    "dataset",
    "media",
    "round_id",
    "model_revision",
    "taxonomy_version",
    "baseline",
    "saved_revision",
    "category_table_sha256",
    "source_frame_entries",
    "coverage",
    "samples",
    "annotation_links",
    "provenance",
    "quality",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "package_type": {"const": "training_coco_v1"},
    "package_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "Project6"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "annotation_format": {"const": "coco_instances"},
    "task": {"enum": ["detection", "instance_segmentation"]},
    "label_origin": {
      "enum": ["human_corrected", "mixed_current_and_baseline"]
    },
    "annotation_path": {"const": "labels/annotation_coco.json"},
    "image_root": {"const": "images"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_namespace", "source_split", "original_video_id"],
      "properties": {
        "dataset_namespace": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source_split": {"enum": ["train", "val", "test"]},
        "original_video_id": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            {"type": "null"}
          ]
        }
      }
    },
    "media": {"$ref": "#/$defs/media"},
    "round_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"enum": ["model", "imported_labels", "empty"]},
        "digest": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "saved_revision": {"type": "integer", "minimum": 0},
    "category_table_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_frame_entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "media-label-v3.schema.json#/properties/frame_entries/items"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "total_frames",
        "included_frames",
        "excluded_frames",
        "negative_frames",
        "source_frame_ids",
        "included_frame_ids",
        "excluded_frame_ids",
        "verified_frame_ids",
        "exclusion_reason"
      ],
      "properties": {
        "policy": {
          "enum": ["verified_only", "all_source_frames", "selected_source_frames"]
        },
        "total_frames": {"type": "integer", "minimum": 1},
        "included_frames": {"type": "integer", "minimum": 1},
        "excluded_frames": {"type": "integer", "minimum": 0},
        "negative_frames": {"type": "integer", "minimum": 0},
        "source_frame_ids": {"$ref": "#/$defs/frame_ids"},
        "included_frame_ids": {"$ref": "#/$defs/nonempty_frame_ids"},
        "excluded_frame_ids": {"$ref": "#/$defs/frame_ids"},
        "verified_frame_ids": {"$ref": "#/$defs/frame_ids"},
        "exclusion_reason": {
          "enum": ["not_content_verified_or_not_selected", "none", "not_selected"]
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id",
          "source_frame_id",
          "source_playback_index",
          "dataset_sequence_index",
          "review_digest",
          "annotation_status"
        ],
        "properties": {
          "image_id": {"$ref": "#/$defs/id"},
          "source_frame_id": {"$ref": "#/$defs/frame_id"},
          "source_playback_index": {"type": "integer", "minimum": 0},
          "dataset_sequence_index": {
            "oneOf": [
              {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              {"type": "null"}
            ]
          },
          "review_digest": {
            "oneOf": [
              {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              {"type": "null"}
            ]
          },
          "review_status": {"enum": ["verified_current", "unverified"]},
          "label_source": {
            "enum": ["current_correction", "previous_baseline", "no_annotation"]
          },
          "annotation_status": {"enum": ["annotated", "negative"]}
        }
      }
    },
    "annotation_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id",
          "source_frame_id",
          "native_region_id",
          "exported_annotation_id",
          "original_annotation_id",
          "geometry_source",
          "area_source",
          "binding_method"
        ],
        "properties": {
          "image_id": {"$ref": "#/$defs/id"},
          "source_frame_id": {"$ref": "#/$defs/frame_id"},
          "native_region_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "exported_annotation_id": {"$ref": "#/$defs/id"},
          "original_annotation_id": {
            "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
          },
          "geometry_source": {
            "enum": ["original_box", "original_rle", "original_polygon", "current_box", "current_polygon"]
          },
          "area_source": {"enum": ["original", "mask", "bbox_fallback"]},
          "binding_method": {"enum": ["native_import_projection", "stable_generated"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_method", "source_files", "batch_operations"],
      "properties": {
        "binding_method": {"const": "endoscapes_multi_view_v1"},
        "source_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "relative_path", "bytes", "sha256"],
            "properties": {
              "role": {"enum": ["detection", "video", "ds"]},
              "relative_path": {"$ref": "#/$defs/safe_path"},
              "bytes": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "batch_operations": {
          "type": "array",
          "items": {"$ref": "media-label-v3.schema.json#/properties/batch_operations/items"}
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_integrity_scope", "time_semantics", "warnings"],
      "properties": {
        "image_integrity_scope": {"const": "export_time_only"},
        "time_semantics": {"const": "source_frame_number_not_certified_seconds"},
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "deleted",
        "label_changed",
        "geometry_changed",
        "attributes_changed",
        "total_frames",
        "included_frames",
        "excluded_frames",
        "changed_frames",
        "changed_regions",
        "negative_frames",
        "annotations",
        "categories"
      ],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "deleted": {"type": "integer", "minimum": 0},
        "label_changed": {"type": "integer", "minimum": 0},
        "geometry_changed": {"type": "integer", "minimum": 0},
        "attributes_changed": {"type": "integer", "minimum": 0},
        "total_frames": {"type": "integer", "minimum": 1},
        "included_frames": {"type": "integer", "minimum": 1},
        "excluded_frames": {"type": "integer", "minimum": 0},
        "changed_frames": {"type": "integer", "minimum": 0},
        "changed_regions": {"type": "integer", "minimum": 0},
        "negative_frames": {"type": "integer", "minimum": 0},
        "annotations": {"type": "integer", "minimum": 0},
        "categories": {"type": "integer", "minimum": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bytes", "sha256"],
        "properties": {
          "role": {"enum": ["annotation", "diff", "image"]},
          "path": {"$ref": "#/$defs/safe_path"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "frame_id": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "frame_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
    },
    "nonempty_frame_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "media_type", "source", "source_relative_path", "source_sha256"],
      "properties": {
        "media_id": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_]{0,62}[A-Za-z0-9])?$"},
        "media_type": {"enum": ["image", "video", "image_sequence"]},
        "source": {"type": "string", "minLength": 1},
        "source_relative_path": {"$ref": "#/$defs/safe_path"},
        "source_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"baseline": {"properties": {"kind": {"enum": ["model", "imported_labels"]}}}}},
      "then": {"properties": {"baseline": {"properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
      "else": {"properties": {"baseline": {"properties": {"digest": {"type": "null"}}}}}
    }
  ]
}
