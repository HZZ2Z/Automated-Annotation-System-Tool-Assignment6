{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-label-v3.schema.json",
  "title": "Review Session Media Label V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "media_id",
    "media_type",
    "source_relative_path",
    "source_sha256",
    "frame_digits",
    "frames",
    "review_state",
    "batch_operations",
    "session_id",
    "source",
    "round_id",
    "model_revision",
    "taxonomy_version",
    "revision",
    "baseline_kind",
    "baseline_digest",
    "baseline_records",
    "explicit_frames",
    "frame_entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "media_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_]{0,62}[A-Za-z0-9])?$"
    },
    "media_type": {
      "enum": [
        "image",
        "video",
        "image_sequence"
      ]
    },
    "source_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "source_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "frame_digits": {
      "const": 6
    },
    "frames": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]{0,5})$"
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "model_output_v1.schema.json"
          },
          {
            "properties": {
              "source": {
                "const": "human_corrected"
              }
            }
          }
        ]
      }
    },
    "review_state": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]{0,5})$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted_digest"
        ],
        "properties": {
          "accepted_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "batch_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "type",
          "keyframe",
          "start_frame",
          "end_frame",
          "mode",
          "affected_frames"
        ],
        "properties": {
          "schema_version": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "type": {
            "const": "range_propagate"
          },
          "mode": {
            "enum": [
              "overwrite",
              "merge"
            ]
          },
          "keyframe": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "end_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "affected_frames": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            }
          },
          "metric_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "keyframe_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](Z)?$"
          },
          "max_frames": {
            "type": "integer",
            "minimum": 1
          },
          "frame_step": {
            "type": "integer",
            "minimum": 1
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "changed_count": {
            "type": "integer",
            "minimum": 1
          },
          "covered_count": {
            "type": "integer",
            "minimum": 1
          },
          "left_stop": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "right_stop": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "edge_refinement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempted",
              "accepted",
              "fallback",
              "items"
            ],
            "properties": {
              "attempted": {
                "type": "integer",
                "minimum": 0
              },
              "accepted": {
                "type": "integer",
                "minimum": 0
              },
              "fallback": {
                "type": "integer",
                "minimum": 0
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "frame_id",
                    "region_id",
                    "accepted",
                    "reason",
                    "raw_edge_score",
                    "refined_edge_score"
                  ],
                  "properties": {
                    "frame_id": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 999999
                    },
                    "region_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "accepted": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "raw_edge_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "refined_edge_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          },
          "provider_id": {
            "type": "string",
            "const": "sam_video"
          },
          "keyframe_playback_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "region_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[\\\\/])[^\\u0000-\u001F\u007F]+$"
          },
          "direction": {
            "const": "forward"
          },
          "requested_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "generated_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "minimum_score": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "maximum_area_change_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          },
          "target_playback_indices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "stop_frame": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 999999
              },
              {
                "type": "null"
              }
            ]
          },
          "stop_reason": {
            "enum": [
              "",
              "source_end",
              "verified_target",
              "model_topology",
              "quality_threshold",
              "user_range"
            ]
          },
          "checkpoint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "device": {
            "enum": [
              "cpu",
              "cuda"
            ]
          },
          "model_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,63}$"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "risk_summary": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frame_id",
                "kinds"
              ],
              "properties": {
                "frame_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999999
                },
                "kinds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "sparse_input",
                      "area_change",
                      "frame_difference",
                      "flow_consistency"
                    ]
                  }
                }
              }
            }
          }
        },
        "dependentRequired": {
          "minimum_score": [
            "maximum_area_change_percent"
          ],
          "maximum_area_change_percent": [
            "minimum_score"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "schema_version": {
                  "const": 2
                }
              },
              "required": [
                "schema_version"
              ]
            },
            "then": {
              "required": [
                "metric_id",
                "threshold",
                "max_frames",
                "keyframe_digest",
                "created_at",
                "start_index",
                "end_index",
                "left_stop",
                "right_stop",
                "changed_count",
                "covered_count",
                "edge_refinement"
              ],
              "not": {
                "required": [
                  "metric"
                ]
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "frame_step"
                    ]
                  },
                  {
                    "required": [
                      "edge_refinement"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "schema_version": {
                  "enum": [
                    1,
                    2
                  ]
                }
              },
              "required": [
                "schema_version",
                "metric_id"
              ]
            },
            "then": {
              "required": [
                "threshold",
                "max_frames",
                "keyframe_digest",
                "created_at",
                "start_index",
                "end_index",
                "left_stop",
                "right_stop",
                "changed_count",
                "covered_count"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "schema_version": {
                  "const": 3
                }
              },
              "required": [
                "schema_version"
              ]
            },
            "then": {
              "required": [
                "provider_id",
                "metric_id",
                "keyframe_playback_index",
                "keyframe_digest",
                "region_id",
                "direction",
                "requested_count",
                "generated_count",
                "target_playback_indices",
                "stop_frame",
                "stop_reason",
                "checkpoint_sha256",
                "device",
                "model_version",
                "elapsed_ms",
                "risk_summary",
                "created_at"
              ],
              "properties": {
                "mode": {
                  "const": "merge"
                },
                "metric_id": {
                  "const": "sam-video-v1"
                }
              },
              "not": {
                "anyOf": [
                  {"required": ["metric"]},
                  {"required": ["threshold"]},
                  {"required": ["max_frames"]},
                  {"required": ["frame_step"]},
                  {"required": ["start_index"]},
                  {"required": ["end_index"]},
                  {"required": ["left_stop"]},
                  {"required": ["right_stop"]},
                  {"required": ["changed_count"]},
                  {"required": ["covered_count"]},
                  {"required": ["edge_refinement"]}
                ]
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {"required": ["minimum_score"]},
                  {"required": ["maximum_area_change_percent"]}
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_kind": {
      "enum": [
        "model",
        "imported_labels",
        "empty",
        "unknown"
      ]
    },
    "baseline_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_records": {
      "type": "array",
      "items": {
        "$ref": "model_output_v1.schema.json"
      }
    },
    "explicit_frames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999
      }
    },
    "frame_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "frame",
          "frame_id"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "frame_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "time_s": {
            "type": "number",
            "minimum": 0
          },
          "image_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "baseline_kind": {
            "enum": [
              "model",
              "imported_labels"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "baseline_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "baseline_records": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "baseline_digest": {
            "type": "null"
          },
          "baseline_records": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
