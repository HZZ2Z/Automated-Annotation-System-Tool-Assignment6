{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-label-v1.schema.json",
  "title": "Workspace Media Label V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "media_id",
    "media_type",
    "source_relative_path",
    "source_sha256",
    "frame_digits",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "media_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_]{0,62}[A-Za-z0-9])?$"
    },
    "media_type": {
      "enum": ["image", "video", "image_sequence"]
    },
    "source_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "source_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "frame_digits": {
      "const": 6
    },
    "frames": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]{0,5})$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
