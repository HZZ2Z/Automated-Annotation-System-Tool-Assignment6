{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source", "frame", "image_size", "regions"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "pattern": "^(?:model_output_v[1-9][0-9]*|human_corrected)\\Z"},
    "frame": {"type": "integer", "minimum": 0},
    "time_s": {"type": "number", "minimum": 0},
    "image_size": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {"type": "integer", "exclusiveMinimum": 0},
        {"type": "integer", "exclusiveMinimum": 0}
      ],
      "items": false
    },
    "regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/region"}
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["instrument", "anatomy", "region"]},
        "box": {
          "type": "array",
          "minItems": 4,
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "items": false
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "items": false
          }
        },
        "conf": {"type": "number", "minimum": 0, "maximum": 1},
        "track_id": {"type": ["string", "null"]},
        "filled": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["box"]},
        {"required": ["polygon"]}
      ]
    }
  }
}
