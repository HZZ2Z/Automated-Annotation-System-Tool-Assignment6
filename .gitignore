# Private local configuration and credentials must never be submitted.
.env
.env.*
*.env
!.env.example
!.env.*.example
!*.example.env
*.local.toml
credentials.json
secrets/
token.txt
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.key
*.pem
*.p12
*.pfx

